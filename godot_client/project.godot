; Engine configuration file.
; It's best edited using the editor and not directly.
;
; Format:
;   [section]
;   param=value

config_version=5

[application]
config/name="钓鱼"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://assets/icon.svg"
config/version="0.1.0-mvp"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1440
window/size/window_height_override=810
window/size/min_width=1024
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
rendering_device/driver="opengl3"
